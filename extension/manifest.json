{
  "manifest_version": 3,
  "name": "Custom-chrome-dev-mcp",
  "version": "0.4.0",
  "description": "custom-chrome-dev-mcp — local-only MCP bridge that drives the active tab like a human.",
  "key": "",
  "permissions": ["tabs", "scripting", "activeTab", "alarms", "debugger", "offscreen", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "Custom-chrome-dev-mcp (MCP bridge — no click action)" }
}
