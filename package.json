    "test:browser": "node ./test/run.mjs --lane=browser",
    "test:all": "node ./test/run.mjs",
    "test:list": "node ./test/run.mjs --list"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "ws": "^8.18.1"
  }

}
