{
  "name": "custom-chrome-dev-mcp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local-only MCP server that drives Chrome like a human, via a companion extension.",
  "license": "MIT",
  "main": "./src/server.js",
  "bin": {
    "custom-chrome-dev-mcp": "./bin/custom-chrome-dev-mcp.js"
  },
  "scripts": {
    "start": "node ./bin/custom-chrome-dev-mcp.js",
    "hub": "node ./src/hub.js",
